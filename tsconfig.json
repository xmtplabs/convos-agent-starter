{
  "include": [
    ".preview-artifact.d.ts",
    ".react-router/types/**/*",
    "src/**/*",
    "workers/**/*",
    "scripts/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "types": ["@cloudflare/workers-types", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "@/*": ["./src/*"] }
  }
}
