{
  "schemaVersion": 1,
  "library": {
    "root": "Page",
    "components": {
      "Page": {
        "signature": "Page(title: string, children?: any[], className?: string)",
        "description": "The required root component for a complete page. Its title names the document but does not add a visible heading; include exactly one Heading at level 1."
      },
      "Section": {
        "signature": "Section(heading?: string, tone?: \"plain\" | \"muted\" | \"accent\", children?: any[], className?: string)",
        "description": "A semantic page section. Give it a heading when it starts a distinct topic."
      },
      "Stack": {
        "signature": "Stack(gap?: \"sm\" | \"md\" | \"lg\" | \"xl\", children?: any[], className?: string)",
        "description": "Vertically stacks related content with a consistent gap."
      },
      "Grid": {
        "signature": "Grid(columns?: 2 | 3 | 4, children?: any[], className?: string)",
        "description": "A responsive grid for peer content such as cards or statistics."
      },
      "Heading": {
        "signature": "Heading(text: string, level?: 1 | 2 | 3, children?: any[], className?: string)",
        "description": "A visible heading. Every page must contain exactly one level-1 Heading."
      },
      "Text": {
        "signature": "Text(text: string, tone?: \"default\" | \"muted\" | \"small\", children?: any[], className?: string)",
        "description": "A paragraph of supporting copy."
      },
      "Link": {
        "signature": "Link(href: string, text: string, newTab?: boolean, children?: any[], className?: string)",
        "description": "A mount-aware navigational link. Use a slash-prefixed local path for another page in this site."
      },
      "Card": {
        "signature": "Card(title?: string, children?: any[], className?: string)",
        "description": "A bordered surface for grouped information."
      },
      "Badge": {
        "signature": "Badge(text: string, tone?: \"neutral\" | \"success\" | \"warning\" | \"danger\", children?: any[], className?: string)",
        "description": "A compact status label."
      },
      "Alert": {
        "signature": "Alert(title: string, description: string, tone?: \"info\" | \"success\" | \"warning\" | \"danger\", children?: any[], className?: string)",
        "description": "A concise status message. Danger alerts are assertive; other tones announce politely."
      },
      "Separator": {
        "signature": "Separator(children?: any[], className?: string)",
        "description": "A visual divider between related sections."
      },
      "Button": {
        "signature": "Button(href?: string, text: string, variant?: \"primary\" | \"secondary\" | \"ghost\", action?: any, children?: any[], className?: string)",
        "description": "A mount-aware navigation button, or an explicit action button when action is supplied. Mutations run only after visitor activation."
      },
      "Input": {
        "signature": "Input(label: string, name: string, placeholder?: string, type?: \"text\" | \"email\" | \"url\" | \"number\", required?: boolean, children?: any[], className?: string)",
        "description": "A labeled single-line form input."
      },
      "Textarea": {
        "signature": "Textarea(label: string, name: string, placeholder?: string, required?: boolean, children?: any[], className?: string)",
        "description": "A labeled multi-line form input."
      },
      "Select": {
        "signature": "Select(label: string, name: string, options: {label: string, value: string}[], required?: boolean, children?: any[], className?: string)",
        "description": "A labeled native select input."
      },
      "Image": {
        "signature": "Image(src: string, alt: string, caption?: string, children?: any[], className?: string)",
        "description": "A mount-aware image with required alternative text. Slash-prefixed local sources resolve inside this site mount."
      },
      "List": {
        "signature": "List(items: string[], ordered?: boolean, children?: any[], className?: string)",
        "description": "A semantic ordered or unordered list."
      },
      "Table": {
        "signature": "Table(caption: string, columns: string[], rows: string[][], children?: any[], className?: string)",
        "description": "A compact, accessible data table."
      },
      "Loading": {
        "signature": "Loading(label?: string, children?: any[], className?: string)",
        "description": "A loading state while page content is being fetched."
      },
      "Empty": {
        "signature": "Empty(title: string, description: string, children?: any[], className?: string)",
        "description": "An empty state when there is no content to show."
      },
      "Stale": {
        "signature": "Stale(text?: string, children?: any[], className?: string)",
        "description": "A notice that the visible page is the last successfully loaded version."
      },
      "ErrorState": {
        "signature": "ErrorState(title: string, description: string, children?: any[], className?: string)",
        "description": "An assertive, recoverable page error state."
      }
    },
