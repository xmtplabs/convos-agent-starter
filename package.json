{
  "name": "convos-agent-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=22.22.0" },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "-"
    },
    "peerDependencyRules": {
      "ignoreMissing": ["@modelcontextprotocol/sdk"]
    }
  },
  "convos": {
    "site": {
      "server": "src/server.tsx",
      "client": "src/client.tsx",
      "compatibilityDate": "2026-07-24",
      "compatibilityFlags": []
    }
  },
  "scripts": {
    "render": "tsx scripts/render.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@openuidev/lang-core": "0.2.10",
    "@openuidev/react-lang": "0.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
