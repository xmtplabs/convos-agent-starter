{
  "name": "convos-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "node scripts/deploy.mjs",
    "dev": "vite",
    "preview:platform": "pnpm build && node scripts/prepare-platform-preview.mjs && wrangler dev --config wrangler.preview.jsonc",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "react-router typegen && tsc --project tsconfig.json",
    "ui:add": "node scripts/add-ui-component.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.26.0",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "isbot": "5.2.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260724.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "shadcn": "4.14.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
