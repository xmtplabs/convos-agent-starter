{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convos-agent-site-platform-preview",
  "main": "workers/preview.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_SERVER",
        "class_name": "PreviewAgentServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PreviewAgentServer"]
    }
  ],
  "worker_loaders": [
    {
      "binding": "SITE_LOADER"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SITE_BLOBS",
      "id": "00000000000000000000000000000002"
    },
    {
      "binding": "LOCAL_ARTIFACTS",
      "id": "00000000000000000000000000000001"
    }
  ],
  "observability": { "enabled": true }
}
